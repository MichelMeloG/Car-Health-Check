# Firebase Web configuration for local development.
# These values identify the Firebase project; they are not service-account secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=car-health-development
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
# Android Emulator: 10.0.2.2. Dispositivo físico: IP local do computador.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2

# Set to true when running Firebase Emulator Suite locally.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
